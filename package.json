{
  "name": "upflowi",
  "version": "0.0.0",
  "description": "Monorepo workspace root: upflowi's headless file transfer engine (packages/*), runnable examples (examples/*), and docs website (apps/website).",
  "license": "ISC",
  "private": true,
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "dev": "pnpm --filter ./packages/core run dev",
    "typecheck": "pnpm --filter './packages/*' run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm --filter './packages/*' run test",
    "test:watch": "pnpm --filter ./packages/core run test:watch",
    "test:coverage": "pnpm --filter './packages/*' exec vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepare": "husky"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "3.0.2",
    "husky": "9.1.7"
  }
}
