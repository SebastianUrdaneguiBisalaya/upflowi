{
  "name": "@upflowi/provider-s3",
  "version": "0.1.0",
  "description": "upflowi storage provider for AWS S3 multipart uploads, driven entirely by presigned URLs your own backend generates. Never receives AWS credentials.",
  "keywords": [
    "upload",
    "file-transfer",
    "s3",
    "aws",
    "multipart",
    "typescript",
    "esm",
    "cjs"
  ],
  "license": "ISC",
  "author": "Sebastian Marat Urdanegui Bisalaya <sebasurdanegui@gmail.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@upflowi/core": "workspace:*"
  },
  "devDependencies": {
    "@upflowi/core": "workspace:*",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
